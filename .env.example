# Base de datos de Zabbix Fibra (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=zabbix
DB_USER=
DB_PASS=

# Base de datos de Zabbix Wireless (PostgreSQL) — instancia separada de la de
# fibra. Solo la usa el endpoint de cortes.
DB_ZBX_WIFI_HOST=
DB_ZBX_WIFI_PORT=5432
DB_ZBX_WIFI_NAME=zabbix
DB_ZBX_WIFI_USER=
DB_ZBX_WIFI_PASS=

# Base de datos Soldef (PostgreSQL)
DB_SOLDEF_HOST=
DB_SOLDEF_PORT=5432
DB_SOLDEF_NAME=soldef
DB_SOLDEF_USER=
DB_SOLDEF_PASS=

# Base de datos Napear (MySQL)
DB_NAP_HOST=
DB_NAP_PORT=3306
DB_NAP_NAME=napear
DB_NAP_USER=
DB_NAP_PASS=

# Base de datos Gestión (MySQL) — clientes, contratos y conexiones.
# Solo la usa el endpoint de cortes.
DB_GESTION_HOST=
DB_GESTION_PORT=3306
DB_GESTION_NAME=
DB_GESTION_USER=
DB_GESTION_PASS=

# API
# Una clave por consumidor: `nombre:clave` separados por coma. El nombre
# identifica quien llama en el log y es la unidad del rate limit, asi que se le
# puede revocar a uno sin cortarle a todos. El nombre no admite ':' ni ','.
API_KEYS=facturacion:CAMBIAR,soporte:CAMBIAR
# Compatibilidad: la clave unica anterior sigue andando, como consumidor
# "legacy". Vaciarla una vez migrados todos los consumidores a API_KEYS.
API_KEY_SECRETA=
# Consumidores que solo pueden usar /api/v1/cortes: nombres de API_KEYS
# separados por coma. Aca van los externos (centralita, chatbot). Sin esto
# cualquier clave valida puede pedir tambien /precinto y /analytics, que
# devuelven el parque completo de todas las empresas y son la vista del NOC.
# Un nombre que no exista en API_KEYS se loguea como ERROR al arrancar: seria
# un consumidor que quedo sin restringir sin que nadie se entere.
API_KEYS_SOLO_CORTES=

# Rate limit por consumidor (cubeta de tokens, en memoria y por proceso: con N
# workers de uvicorn el limite efectivo es N veces este numero). En 0 se
# desactiva. Un request puede disparar decenas de consultas SNMP contra una OLT,
# asi que un loop sobre numeros de cliente le hace DoS a la red, no a la API.
RATE_LIMIT_POR_MINUTO=60
RATE_LIMIT_BURST=60
# Cuota propia de precinto y analiticas. Va mucho mas baja que la de cortes: una
# analitica recorre el parque entero de la empresa aunque se pida limit=1, y
# comparte con /cortes el pool de zabbix. Es lo que evita que un tablero
# refrescando deje sin atender a la centralita.
RATE_LIMIT_INTERNO_POR_MINUTO=10
RATE_LIMIT_INTERNO_BURST=10
# Cuota distinta para un consumidor puntual: `nombre:por_minuto` separados por
# coma. Ajusta la cuota general (la de /cortes), no la interna. Lo que no
# aparezca usa RATE_LIMIT_POR_MINUTO. 0 = sin limite para ese consumidor.
# Sirve para que un chatbot con entrada de usuario no tenga la misma cuota que
# una centralita que hace un request por llamada atendida.
RATE_LIMIT_POR_CONSUMIDOR=
# Tope de filas por serie del endpoint de precinto. Una ONU sola en la ventana
# maxima da ~10.000 puntos, asi que no toca el caso legitimo.
PRECINTO_MAX_FILAS=50000
ENVIRONMENT=production

# Qué endpoints monta esta instancia: completo | critico | interno
#   critico   /cortes                  app móvil, centralita y chatbot (99%)
#   interno   /precinto  /analytics    tableros
#   completo  todos                    una sola instancia (default)
# La crítica no monta los internos, así que un request mal ruteado da 404 en vez
# de llevarse conexiones del pool que protege a /cortes. Un valor inválido aborta
# el arranque a propósito. Ver "Despliegue en dos fleets" en el README.
API_PERFIL=completo
LOG_LEVEL=INFO

# Clasificación de caídas (opcionales)
VENTANA_POWERFAIL_SEG=900
LOS_VIGENTE_DIAS=7

# Límites de las consultas pesadas (opcionales)
QUERY_CHUNK_SIZE=10000
STATEMENT_TIMEOUT_MS=120000
POOL_MIN=1
# Tiene que cubrir la demanda máxima de los tres endpoints a la vez:
# cortes 5x2 + analytics 2x2 + precinto 2x1 = 16. main.py verifica la cuenta al
# arrancar y avisa por log si no cierra.
POOL_MAX=16

# Detección de cortes (/api/v1/cortes)
# Categorías de plan de Gestión (category.category_id). Son las dos únicas que
# trae la consulta y las dos únicas que contempla el endpoint.
CATEGORIA_FTTH_ID=16
CATEGORIA_WIRELESS_ID=17
# Tamaño de NAP a partir del cual se tolera un cliente sin reportar LOS.
NAP_TOLERANCIA_DESDE=3
CORTES_STATEMENT_TIMEOUT_MS=15000
CORTES_MAX_WORKERS=6
CORTES_MAX_OIDS_NAP=64
# OIDs por invocacion de snmpget: van todos en el mismo PDU. El tope evita que
# la respuesta no entre en la MTU y se pierda entera.
SNMP_OIDS_POR_CONSULTA=20

# Cache del estado compartido por todos los clientes de una caja: estado de NAP,
# ping a la OLT/switch/AP/RouterBoard. Nada por cliente se cachea. En 0 se
# desactiva. Subirlo ahorra carga; bajarlo reduce cuanto puede tardar en verse
# un corte que acaba de empezar.
CACHE_ZONA_TTL_SEG=45
CACHE_MAX_ENTRADAS=5000
# Cuanto se sigue sirviendo un valor vencido cuando el recalculo falla o queda en
# "no evaluable". Evita que un pico de lentitud en Zabbix haga que la API diga
# "no hay corte de zona" en medio de un corte. Pasado el plazo se acepta el
# sin-dato, para que una NAP que dejo de reportar no quede caida para siempre.
CACHE_STALE_MAX_SEG=300

# Cache de la topologia del cliente: su tecnologia e IP en Gestion, su NAP/OLT
# (o AP/RouterBoard) en Zabbix. Es lo unico por cliente que se cachea, porque no
# es estado: cambia al provisionar o mudar, no cuando hay un corte.
# No esta para ahorrar consultas sino para no quedarse sin respuesta: son las dos
# unicas consultas obligatorias del endpoint, y sin ellas sale 503.
# OJO: si la IP de un cliente cambia, durante el TTL se pingea la anterior y
# isOnline sale mal. Con IPs fijas es irrelevante. En 0 se desactiva.
CACHE_TOPOLOGIA_TTL_SEG=300
CACHE_TOPOLOGIA_STALE_MAX_SEG=3600
CACHE_TOPOLOGIA_MAX_ENTRADAS=20000
# Tope de tiempo de respuesta (504) y requests de cortes procesados a la vez.
# Cada request de cortes usa como mucho 2 conexiones de zabbix.
CORTES_TIMEOUT_SEG=25
CORTES_MAX_CONCURRENTES=5

# Admisión de los endpoints internos (/precinto y /analytics)
# Sin esto los acota el threadpool de FastAPI: 40 hilos, un número que nadie
# eligió para esta API. Son tableros, así que encolar les cuesta menos que a
# /cortes quedarse sin conexiones. En 0 se desactiva el tope (y el arranque
# avisa, porque la demanda deja de estar acotada).
ANALYTICS_MAX_CONCURRENTES=2
PRECINTO_MAX_CONCURRENTES=2
# Espera por un lugar antes de rendirse con 503. Es espera en el event loop, no
# en un hilo.
INTERNO_ESPERA_SEG=10

# Utilidades del sistema. Requieren los paquetes iputils-ping y snmp instalados.
PING_PATH=/bin/ping
PING_COUNT=2
PING_TIMEOUT_SEG=2
SNMPGET_PATH=/usr/bin/snmpget
# Comunidad SNMP de solo lectura de las OLT Solar. Es un secreto: sin ella el
# camino Solar no puede evaluarse y queda todo en "no evaluable".
SNMP_COMMUNITY=
SNMP_VERSION=2c
SNMP_TIMEOUT_SEG=3
SNMP_RETRIES=1

# Traduccion de los enteros que devuelve un snmpget crudo contra la OLT (Zabbix
# guarda el texto ya mapeado; la OLT devuelve el codigo del MIB). Estos son los
# defaults, verificados contra las OLT del parque:
#     hwGponDeviceOntAlarmLOSi            1 = No Alarm   2 = LOS / LOSi
#     hwGponDeviceOntEthernetOnlineState  1 = Online     2 = Offline
# Solo hay que tocarlas si aparece una OLT de otro vendor. Aceptan varios codigos
# separados por coma. Un codigo desconocido queda en "no evaluable" y se loguea.
SNMP_COD_LOS=2
SNMP_COD_SIN_LOS=1
SNMP_COD_OFFLINE=2
SNMP_COD_ONLINE=1

# Origenes del panel web que consume la API desde el navegador (CORS).
# Vacio = CORS apagado. Solo hace falta si hay un frontend en otro dominio.
# CORS_ORIGINS=https://panel.westnet.com.ar
